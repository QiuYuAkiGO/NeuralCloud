+// Usage inputTokens excludes cached reads in this adapter. Prefer total-output
+// so cached prefixes are counted once, never mistaken for a small prompt.
+export function contextEstimate(events) {
+  let tokens = 0, limited = false;
+  for (const e of events) {
+    if (e.type === 'assistant/message') {
+      const u = e.data?.usage;
+      if (u && Number.isFinite(u.totalTokens) && Number.isFinite(u.outputTokens)) {
+        tokens = Math.max(0, u.totalTokens); // prompt plus generated history
+      } else tokens += blocks(e.data?.message?.content);
+    } else if (e.type === 'user/message' || e.type === 'system/message') {
+      tokens += blocks(e.data?.message?.content ?? e.data?.content);
+    } else if (e.type === 'tool/result') tokens += blocks(e.data?.message?.content);
+    else if (e.type === 'tool/call') tokens += Buffer.byteLength(e.data?.arguments ?? '') + 32;
+    if (e.type === 'turn/end') limited = e.data?.reason?.kind === 'max-tokens';
+  }
+  return { tokens, limited };
+}
+function blocks(content = []) {
+  return content.reduce((n, b) => n + (b.type === 'image' ? 16384
+    : Buffer.byteLength(b.text ?? '') + 16), 0);
+}
+export function compressionThreshold(window, output, ratio) {
+  if (!Number.isSafeInteger(window) || window < 4096 || !Number.isSafeInteger(output)
+      || output < 0 || output >= window || !Number.isFinite(ratio) || ratio < 0.3 || ratio > 0.85)
+    throw new Error('INVALID_CONTEXT_BUDGET');
+  return Math.floor((window - output) * ratio);
+}
