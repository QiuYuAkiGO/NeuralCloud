+import { tmpdir } from 'node:os';
+import { join, dirname, resolve } from 'node:path';
+import { freezeMessage } from '@deepseek-ai/dsh-llm';
+import { initialize, fixture } from './fixtures/resident-support.mjs';
+import { summaryInput } from '../resident/continuity.mjs';
+
+const key = 'qqbot:fixture:group:test';
+const message = id => freezeMessage({ id, role: 'user', source: { kind: 'user' }, content: [{ type: 'text', text: '请记住下次继续讨论蓝色蝴蝶结 ' + id }] });
+function cleanup(root) {
+  assert.equal(dirname(resolve(root)), resolve(tmpdir()));
+  assert.ok(root.startsWith(join(tmpdir(), 'misty-continuity-')));
+  rmSync(root, { recursive: true });
+}
+function model(instance, failSummary = false) {
+  const requests = [];
+  instance.model.stream = async function* (request) {
+    requests.push(request);
+    const isSummary = JSON.stringify(request.messages).includes('SESSION_CONTINUITY_SUMMARY_V1');
+    if (isSummary && failSummary) {
+      yield { type: 'finish', reason: { kind: 'error', failure: { message: 'synthetic', code: 'UNKNOWN' } } }; return;
+    }
+    const text = isSummary ? '用户希望下次继续讨论蓝色蝴蝶结。普通文本是未发送草稿；历史未证明任何消息送达。' : '未发送草稿';
+    yield { type: 'block-start', index: 0, blockType: 'text' };
+    yield { type: 'text-delta', index: 0, text };
+    yield { type: 'block-end', index: 0, block: { type: 'text', text } };
+    yield { type: 'finish', reason: { kind: 'stop' } };
+  };
+  return requests;
+}
+async function fill(instance, prefix) {
+  const { agent } = await instance.runtime.get(key);
+  for (let i = 0; agent.session.seq < 32 && i < 10; i++) {
+    agent.followup(message(prefix + i)); await agent.whenIdle();
+  }
+  return agent;
+}
+test('rotation compresses before replacement, inherits summary through restart and next rotation, and reinjects real tools', async () => {
+  const root = mkdtempSync(join(tmpdir(), 'misty-continuity-')); initialize(root);
+  let instance = await fixture(root, { maxSessionEvents: 32 });
+  try {
+    let requests = model(instance);
+    const old = await fill(instance, 'first-');
+    await instance.runtime.pulse();
+    const summaryRequest = requests.find(r => JSON.stringify(r.messages).includes('SESSION_CONTINUITY_SUMMARY_V1'));
+    assert.ok(summaryRequest); assert.deepEqual(summaryRequest.tools, []);
+    assert.match(JSON.stringify(summaryRequest), /assistant_text_NOT_delivery_receipt/);
+    const replacement = await instance.runtime.get(key);
+    const target = replacement.agent.id;
+    assert.notEqual(target, old.id);
+    const handoff = instance.runtime.continuity(target);
+    assert.equal(handoff.source_id, old.id);
+    assert.match(handoff.summary, /蓝色蝴蝶结/);
+    assert.ok(await instance.ctx.sessionPersistence.stat(old.id));
+    replacement.agent.followup(message('after-rotation')); await replacement.agent.whenIdle();
+    const request = requests.at(-1);
+    assert.match(JSON.stringify(request.messages), /compressed_session_history/);
+    assert.match(JSON.stringify(request.messages), /普通 assistant 文本是内部记录/);
+    assert.match(JSON.stringify(request.messages), /group:test/);
+    assert.ok(request.tools.some(t => t.name === 'misty_send'));
+    assert.ok(request.tools.some(t => t.name === 'misty_wait'));
+    assert.equal(instance.outbox.status().pending, 0);
+    await instance.close(); instance = await fixture(root, { maxSessionEvents: 32 });
+    requests = model(instance);
+    const resumed = await instance.runtime.get(key);
+    assert.equal(resumed.agent.id, target);
+    resumed.agent.followup(message('after-restart')); await resumed.agent.whenIdle();
+    assert.match(JSON.stringify(requests.at(-1).messages), /compressed_session_history/);
+    assert.ok(requests.at(-1).tools.some(t => t.name === 'misty_send'));
+    await fill(instance, 'second-'); await instance.runtime.pulse();
+    const second = requests.find(r => JSON.stringify(r.messages).includes('SESSION_CONTINUITY_SUMMARY_V1'));
+    assert.match(JSON.stringify(second.messages), /prior_summary/);
+    assert.match(JSON.stringify(second.messages), /蓝色蝴蝶结/);
+    assert.equal(instance.runtime.db.prepare('SELECT count(*) AS n FROM retired').get().n, 2);
+  } finally { await instance.close(); cleanup(root); }
+});
+test('summary failure preserves old session, never creates an empty replacement and never loops model billing', async () => {
+  const root = mkdtempSync(join(tmpdir(), 'misty-continuity-')); initialize(root);
+  const instance = await fixture(root, { maxSessionEvents: 32 });
+  try {
+    instance.runtime.summaryMaxAttempts = 1;
+    const requests = model(instance, true), old = await fill(instance, 'failure-');
+    await assert.rejects(instance.runtime.pulse(), /SUMMARY/);
+    assert.equal(instance.runtime.db.prepare('SELECT id FROM active').get().id, old.id);
+    assert.equal(instance.runtime.db.prepare('SELECT count(*) AS n FROM retired').get().n, 0);
+    const count = requests.length;
+    await assert.rejects(instance.runtime.pulse(), /SESSION_SUMMARY_REVIEW_REQUIRED/);
+    assert.equal(requests.length, count);
+    assert.ok(await instance.ctx.sessionPersistence.stat(old.id));
+  } finally { await instance.close(); cleanup(root); }
+});
+test('summary source labels plain text as non-receipt and preserves UNKNOWN separately from SENT', () => {
+  const events = [
+    { seq: 0, type: 'assistant/message', data: { message: { content: [{ type: 'text', text: '我已经发了' }] } } },
+    { seq: 1, type: 'tool/call', data: { callId: 'one', name: 'misty_send', arguments: '{}' } },
+    { seq: 2, type: 'tool/result', data: { message: { toolCallId: 'one', content: [{ type: 'text', text: '{"status":"UNKNOWN"}' }] } } },
+  ];
+  const input = summaryInput(events, { summary: '此前讨论音乐' });
+  assert.equal(input.prior_summary, '此前讨论音乐');
+  assert.equal(input.rows[0].kind, 'assistant_text_NOT_delivery_receipt');
+  assert.equal(input.delivery_facts[0].status, 'UNKNOWN');
+  assert.equal(input.delivery_facts[0].external_id, null);
+});
+test('prepared summary survives a failed retirement transaction and is reused without a second inference', async () => {
+  const root = mkdtempSync(join(tmpdir(), 'misty-continuity-')); initialize(root);
+  const instance = await fixture(root, { maxSessionEvents: 32 });
+  try {
+    const requests = model(instance), old = await fill(instance, 'transaction-');
+    const audit = instance.runtime.audit.bind(instance.runtime);
+    instance.runtime.audit = (action, payload) => {
+      if (action === 'SESSION_HANDOFF') throw new Error('SYNTHETIC_COMMIT_FAILURE');
+      return audit(action, payload);
+    };
+    await assert.rejects(instance.runtime.pulse(), /SYNTHETIC_COMMIT_FAILURE/);
+    const count = requests.length;
+    assert.equal(instance.runtime.db.prepare('SELECT id FROM active').get().id, old.id);
+    instance.runtime.audit = audit;
+    await instance.runtime.pulse();
+    assert.equal(requests.length, count);
+    const target = instance.runtime.db.prepare('SELECT id FROM active').get().id;
+    assert.equal(instance.runtime.continuity(target).source_id, old.id);
+    instance.runtime.db.prepare("UPDATE audit SET payload=json_set(payload,'$.summary','tampered') WHERE action='SESSION_HANDOFF'").run();
+    assert.throws(() => instance.runtime.continuity(target), /INTEGRITY/);
+  } finally { await instance.close(); cleanup(root); }
+});
