# Character (main) model for NeuralCloud live mode.
# Base: Qwen3-30B-A3B-Instruct-2507 abliterated, Q4_K_M (~19GB).
# Instruct-2507 is non-thinking; abliteration removes refusals for in-character RP.
# Bound KV cache: the upstream tag defaults to 256K and will not fit beside the 4B aux on 32GB.
FROM huihui_ai/qwen3-abliterated:30b-a3b-instruct-2507-q4_K_M
PARAMETER num_ctx 16384
PARAMETER num_gpu 99
PARAMETER temperature 0.7
