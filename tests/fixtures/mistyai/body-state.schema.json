{
  "$defs": {
    "ComputeState": {
      "additionalProperties": false,
      "properties": {
        "cpu_pressure": {
          "maximum": 1,
          "minimum": 0,
          "title": "Cpu Pressure",
          "type": "number"
        },
        "gpu_pressure": {
          "maximum": 1,
          "minimum": 0,
          "title": "Gpu Pressure",
          "type": "number"
        },
        "memory_pressure": {
          "maximum": 1,
          "minimum": 0,
          "title": "Memory Pressure",
          "type": "number"
        }
      },
      "required": [
        "cpu_pressure",
        "gpu_pressure",
        "memory_pressure"
      ],
      "title": "ComputeState",
      "type": "object"
    },
    "EnergyState": {
      "additionalProperties": false,
      "properties": {
        "available_ratio": {
          "maximum": 1,
          "minimum": 0,
          "title": "Available Ratio",
          "type": "number"
        },
        "available_units": {
          "minimum": 0,
          "title": "Available Units",
          "type": "number"
        },
        "capacity_units": {
          "exclusiveMinimum": 0,
          "title": "Capacity Units",
          "type": "number"
        },
        "charging": {
          "default": false,
          "title": "Charging",
          "type": "boolean"
        },
        "delta_units_per_minute": {
          "title": "Delta Units Per Minute",
          "type": "number"
        },
        "estimated_time_to_terminal_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Time To Terminal Seconds"
        },
        "terminal": {
          "default": false,
          "title": "Terminal",
          "type": "boolean"
        }
      },
      "required": [
        "capacity_units",
        "available_units",
        "available_ratio",
        "delta_units_per_minute"
      ],
      "title": "EnergyState",
      "type": "object"
    },
    "IntegrityState": {
      "additionalProperties": false,
      "properties": {
        "overall": {
          "maximum": 1,
          "minimum": 0,
          "title": "Overall",
          "type": "number"
        }
      },
      "required": [
        "overall"
      ],
      "title": "IntegrityState",
      "type": "object"
    },
    "ThermalState": {
      "additionalProperties": false,
      "properties": {
        "normalized_pressure": {
          "maximum": 1,
          "minimum": 0,
          "title": "Normalized Pressure",
          "type": "number"
        },
        "throttling": {
          "default": false,
          "title": "Throttling",
          "type": "boolean"
        }
      },
      "required": [
        "normalized_pressure"
      ],
      "title": "ThermalState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "body_instance_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Body Instance Id",
      "type": "string"
    },
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "compute": {
      "anyOf": [
        {
          "$ref": "#/$defs/ComputeState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "energy": {
      "$ref": "#/$defs/EnergyState"
    },
    "episode_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Episode Id",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "integrity": {
      "anyOf": [
        {
          "$ref": "#/$defs/IntegrityState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "body-state-v1",
      "default": "body-state-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "thermal": {
      "anyOf": [
        {
          "$ref": "#/$defs/ThermalState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "body_instance_id",
    "episode_id",
    "revision",
    "captured_at",
    "energy",
    "evidence_refs"
  ],
  "title": "BodyStateSnapshot",
  "type": "object"
}
