# Character model (complete_chat / CharacterModel)
# Default live stack is Ollama on :11434. Recommended main model on RTX 5090 32GB:
#   ollama pull huihui_ai/qwen3-abliterated:30b-a3b-instruct-2507-q4_K_M
#   ollama create neuralcloud-main -f infra/llm/Modelfile.character
# neuralcloud-main caps num_ctx at 16384 so the 30B MoE can sit beside the 4B aux.
# llama.cpp on :8080 remains valid if you serve a GGUF yourself.
NC_LLM_BASE_URL=http://127.0.0.1:11434/v1
NC_LLM_MODEL=neuralcloud-main

# QQ gate/draft data budget, using the compiler's approximate two chars/token.
# Includes the later assessment; output caps and the caller's deadline are separate.
# NC_QQ_INPUT_TOKEN_BUDGET=96000
# NC_QQ_MEMORY_RECALL_MAX_CHARACTERS=16000

# Auxiliary small model for parser / gate / interpreter / validator / planner / curator.
# Use the instruct (non-thinking) tag: qwen3:4b is an alias of 4b-thinking and
# emits <think> blocks that break complete_json. qwen3:4b-instruct is Q4_K_M, ~2.5GB.
NC_AUX_LLM_BASE_URL=http://127.0.0.1:11434/v1
NC_AUX_LLM_MODEL=qwen3:4b-instruct
NC_AUX_LLM_PRELOAD=true
NC_AUX_LLM_KEEP_ALIVE=-1
NC_AUX_LLM_NUM_CTX=8192

# Embeddings (OpenAI-compat /v1/embeddings). GUI live/ollama injects this
# client; if the factory llama.cpp URL is down it falls back to local Ollama.
NC_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
NC_EMBEDDING_MODEL=bge-m3

# Successful-call debug dump: one JSON file per top-level success
# under traces/calls/YYYYMMDD/{call_id}.json. GUI forces this on.
# NC_CALL_LOG_ENABLED=true
# Content-free physical request usage/timing; independent of the debug dump.
# Enabled by default, including QQ requests with call logging disabled.
# NC_MODEL_REQUEST_LOG_ENABLED=true
# NC_TRACE_DIR=traces

# Local Runtime operations dashboard (/ops). The SQLite file is a rebuildable
# projection; Runtime journal and call logs remain the sources of truth.
# NC_MONITOR_DB=data/runtime/observability.sqlite3
# NC_MONITOR_RETENTION_DAYS=7
# NC_MONITOR_SAMPLE_SECONDS=10

# Embodiment provider is selected only by the Runtime composition root.
# Keep "none" for the backward-compatible chat-only mode.
NC_EMBODIMENT_PROVIDER=none
# NC_EMBODIMENT_PROVIDER=mistyai
# NC_MISTYAI_BASE_URL=http://127.0.0.1:8787
# Prefer a restricted token file; the inline variable remains supported for compatibility.
# NC_MISTYAI_TOKEN_FILE=C:\ProgramData\MistyAI\body-service.token
# Independent voice body (the file binds a real VoiceProfile revision and API token file).
# Use port 8794 for voice when NeuralCloud Runtime owns port 8770.
# NC_VOICE_CONFIG=C:\ProgramData\MistyAI\voice\neuralcloud-client.json
# Web search body: configure Tavily connection, key, quotas and authorization in GUI /web.
# Saved revisions become active at the next Runtime startup; the key stays in a private file.
# This optional absolute index path is injected into the Runtime child only.
# NC_WEB_CONFIG=C:\ProgramData\NeuralCloud\runtime\web\config.json
# NC_MISTYAI_TOKEN=replace-with-body-service-token
# NC_MISTYAI_TIMEOUT_SECONDS=10
# NC_MISTYAI_POLL_INTERVAL_SECONDS=0.2

# Deterministic in-process provider (tests and local dry runs).
# NC_EMBODIMENT_PROVIDER=simulator
# NC_SIMULATOR_SEED=0
# NC_SIMULATOR_OBSERVATION_ONLY=false
# NC_SIMULATOR_OFFLINE=false
# NC_SIMULATOR_PHYSIOLOGY=false

# MistyAI body-contract-v1 (used only when the selected Runtime manifest is
# observe or grounded; off mode never constructs or calls a body client).
# NC_RUNTIME_MANIFEST_PATH=presets/runtime/grounded-mistyai-v1.json
# NC_MISTYAI_URL=http://127.0.0.1:8787
# NC_MISTYAI_TOKEN_FILE=C:\ProgramData\MistyAI\body-service.token
# Qwen emotion director: a shared Runtime uses its manifest's emotion_mode.
# off preserves the original path; shadow records a comparison; on injects the brief.
NC_EMOTION_MODE=off
NC_EMOTION_HALF_LIFE_SECONDS=600
NC_EMOTION_WINDOW_SECONDS=1800
NC_EMOTION_WINDOW_MESSAGES=20
NC_EMOTION_PERSONALITY_BASELINE=0.25
NC_EMOTION_APPRAISAL_TIMEOUT_SECONDS=8
NC_EMOTION_GUIDANCE_TIMEOUT_SECONDS=4
NC_EMOTION_MAIN_RESERVE_SECONDS=10
NC_EMOTION_INPUT_TOKEN_BUDGET=6000
