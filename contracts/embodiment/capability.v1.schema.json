{
  "$defs": {
    "CapabilityDescriptor": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "title": "Capability",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "implementation_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Implementation Version"
        },
        "limits": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Limits",
          "type": "object"
        },
        "status": {
          "$ref": "#/$defs/CapabilityStatus"
        }
      },
      "required": [
        "capability",
        "status"
      ],
      "title": "CapabilityDescriptor",
      "type": "object"
    },
    "CapabilityStatus": {
      "enum": [
        "available",
        "degraded",
        "unavailable"
      ],
      "title": "CapabilityStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "body_instance_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Body Instance Id"
    },
    "capabilities": {
      "items": {
        "$ref": "#/$defs/CapabilityDescriptor"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "provider_id": {
      "minLength": 1,
      "title": "Provider Id",
      "type": "string"
    },
    "provider_kind": {
      "minLength": 1,
      "title": "Provider Kind",
      "type": "string"
    },
    "provider_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Revision"
    }
  },
  "required": [
    "provider_id",
    "provider_kind",
    "capabilities",
    "observed_at"
  ],
  "title": "ProviderCapabilities",
  "type": "object"
}
