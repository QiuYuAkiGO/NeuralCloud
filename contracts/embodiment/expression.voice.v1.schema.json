{
  "$defs": {
    "EmbodimentState": {
      "enum": [
        "disabled",
        "available",
        "degraded",
        "unavailable",
        "terminal"
      ],
      "title": "EmbodimentState",
      "type": "string"
    },
    "EmbodimentStatus": {
      "additionalProperties": false,
      "properties": {
        "activated_capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Activated Capabilities",
          "type": "array",
          "uniqueItems": true
        },
        "body_instance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body Instance Id"
        },
        "effective_capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Effective Capabilities",
          "type": "array",
          "uniqueItems": true
        },
        "health": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderHealth"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "negotiated": {
          "anyOf": [
            {
              "$ref": "#/$defs/NegotiatedCapabilitySet"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provider_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Id"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "state": {
          "$ref": "#/$defs/EmbodimentState",
          "default": "disabled"
        }
      },
      "title": "EmbodimentStatus",
      "type": "object"
    },
    "GenerationProvenance": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Backend",
          "type": "string"
        },
        "code_revision": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Code Revision",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Metrics",
          "type": "object"
        },
        "model_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "model_revision": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Model Revision",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "seed": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "weights_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Weights Sha256",
          "type": "string"
        }
      },
      "required": [
        "backend",
        "model_id",
        "model_revision",
        "weights_sha256",
        "code_revision",
        "seed"
      ],
      "title": "GenerationProvenance",
      "type": "object"
    },
    "HealthStatus": {
      "enum": [
        "healthy",
        "degraded",
        "unavailable"
      ],
      "title": "HealthStatus",
      "type": "string"
    },
    "JsonValue": {},
    "NegotiatedCapabilitySet": {
      "additionalProperties": false,
      "properties": {
        "degraded": {
          "items": {
            "type": "string"
          },
          "title": "Degraded",
          "type": "array",
          "uniqueItems": true
        },
        "enabled": {
          "items": {
            "type": "string"
          },
          "title": "Enabled",
          "type": "array",
          "uniqueItems": true
        },
        "incompatible_required": {
          "items": {
            "type": "string"
          },
          "title": "Incompatible Required",
          "type": "array",
          "uniqueItems": true
        },
        "missing_required": {
          "items": {
            "type": "string"
          },
          "title": "Missing Required",
          "type": "array",
          "uniqueItems": true
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Revision"
        },
        "unavailable_optional": {
          "items": {
            "type": "string"
          },
          "title": "Unavailable Optional",
          "type": "array",
          "uniqueItems": true
        },
        "unknown_provided": {
          "items": {
            "type": "string"
          },
          "title": "Unknown Provided",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "provider_id"
      ],
      "title": "NegotiatedCapabilitySet",
      "type": "object"
    },
    "PauseSegment": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "maximum": 30000,
          "minimum": 1,
          "title": "Duration Ms",
          "type": "integer"
        },
        "kind": {
          "const": "pause",
          "default": "pause",
          "title": "Kind",
          "type": "string"
        },
        "segment_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
          "title": "Segment Id",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "duration_ms"
      ],
      "title": "PauseSegment",
      "type": "object"
    },
    "ProfileReference": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "voice_profile_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
          "title": "Voice Profile Id",
          "type": "string"
        }
      },
      "required": [
        "voice_profile_id",
        "revision"
      ],
      "title": "ProfileReference",
      "type": "object"
    },
    "Pronunciation": {
      "additionalProperties": false,
      "properties": {
        "phonemes": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Phonemes",
          "type": "array"
        },
        "text": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "phonemes"
      ],
      "title": "Pronunciation",
      "type": "object"
    },
    "ProviderHealth": {
      "additionalProperties": false,
      "properties": {
        "body_instance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body Instance Id"
        },
        "capability_health": {
          "additionalProperties": {
            "$ref": "#/$defs/HealthStatus"
          },
          "title": "Capability Health",
          "type": "object"
        },
        "detail": {
          "additionalProperties": true,
          "title": "Detail",
          "type": "object"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/HealthStatus"
        }
      },
      "required": [
        "provider_id",
        "status",
        "observed_at"
      ],
      "title": "ProviderHealth",
      "type": "object"
    },
    "RenderResult": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "$ref": "#/$defs/VoiceAsset"
        },
        "kind": {
          "const": "render",
          "default": "render",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "asset"
      ],
      "title": "RenderResult",
      "type": "object"
    },
    "RenderedSegment": {
      "additionalProperties": false,
      "properties": {
        "audio_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Audio Digest",
          "type": "string"
        },
        "compiler_version": {
          "title": "Compiler Version",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "kind": {
          "enum": [
            "speech",
            "pause",
            "vocalization"
          ],
          "title": "Kind",
          "type": "string"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/GenerationProvenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "reused_from_job_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reused From Job Id"
        },
        "sample_count": {
          "minimum": 1,
          "title": "Sample Count",
          "type": "integer"
        },
        "segment_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
          "title": "Segment Id",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "required": [
        "segment_id",
        "kind",
        "input_sha256",
        "audio_digest",
        "sample_count",
        "compiler_version"
      ],
      "title": "RenderedSegment",
      "type": "object"
    },
    "SpeechSegment": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "speech",
          "default": "speech",
          "title": "Kind",
          "type": "string"
        },
        "pronunciations": {
          "items": {
            "$ref": "#/$defs/Pronunciation"
          },
          "maxItems": 32,
          "title": "Pronunciations",
          "type": "array"
        },
        "rate": {
          "default": 1.0,
          "maximum": 1.25,
          "minimum": 0.75,
          "title": "Rate",
          "type": "number"
        },
        "segment_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
          "title": "Segment Id",
          "type": "string"
        },
        "strength": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Strength",
          "type": "string"
        },
        "style": {
          "default": "neutral",
          "enum": [
            "neutral",
            "happy",
            "sad",
            "angry",
            "surprised",
            "gentle"
          ],
          "title": "Style",
          "type": "string"
        },
        "text": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "text"
      ],
      "title": "SpeechSegment",
      "type": "object"
    },
    "TimelineSegment": {
      "additionalProperties": false,
      "properties": {
        "audio_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Audio Digest",
          "type": "string"
        },
        "end_sample": {
          "exclusiveMinimum": 0,
          "title": "End Sample",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "speech",
            "pause",
            "vocalization"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sample_rate": {
          "const": 24000,
          "default": 24000,
          "title": "Sample Rate",
          "type": "integer"
        },
        "segment_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
          "title": "Segment Id",
          "type": "string"
        },
        "start_sample": {
          "minimum": 0,
          "title": "Start Sample",
          "type": "integer"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "required": [
        "segment_id",
        "kind",
        "audio_digest",
        "start_sample",
        "end_sample"
      ],
      "title": "TimelineSegment",
      "type": "object"
    },
    "VocalizationSegment": {
      "additionalProperties": false,
      "properties": {
        "approved_asset_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved Asset Id"
        },
        "kind": {
          "const": "vocalization",
          "default": "vocalization",
          "title": "Kind",
          "type": "string"
        },
        "segment_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
          "title": "Segment Id",
          "type": "string"
        },
        "vocalization": {
          "enum": [
            "breath",
            "laughter",
            "sigh"
          ],
          "title": "Vocalization",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "vocalization"
      ],
      "title": "VocalizationSegment",
      "type": "object"
    },
    "VoiceAsset": {
      "additionalProperties": false,
      "properties": {
        "audio_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Audio Digest",
          "type": "string"
        },
        "manifest_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Digest",
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/ProfileReference"
        },
        "quality_checks": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Quality Checks",
          "type": "object"
        },
        "sample_count": {
          "exclusiveMinimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "sample_rate": {
          "const": 24000,
          "default": 24000,
          "title": "Sample Rate",
          "type": "integer"
        },
        "schema_version": {
          "const": "voice-contract-v1",
          "default": "voice-contract-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "script_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Script Digest",
          "type": "string"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/TimelineSegment"
          },
          "title": "Segments",
          "type": "array"
        },
        "timeline_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Timeline Digest",
          "type": "string"
        }
      },
      "required": [
        "profile",
        "audio_digest",
        "timeline_digest",
        "script_digest",
        "manifest_digest",
        "sample_count",
        "segments"
      ],
      "title": "VoiceAsset",
      "type": "object"
    },
    "VoiceJob": {
      "additionalProperties": false,
      "properties": {
        "completed_segments": {
          "items": {
            "$ref": "#/$defs/RenderedSegment"
          },
          "title": "Completed Segments",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "job_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
          "title": "Job Id",
          "type": "string"
        },
        "kind": {
          "const": "render",
          "default": "render",
          "title": "Kind",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/RenderResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "voice-contract-v1",
          "default": "voice-contract-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ],
          "title": "State",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "state",
        "input_sha256",
        "created_at",
        "updated_at"
      ],
      "title": "VoiceJob",
      "type": "object"
    },
    "VoiceProfile": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "design_job_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
          "title": "Design Job Id",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/GenerationProvenance"
        },
        "reference_audio_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reference Audio Digest",
          "type": "string"
        },
        "reference_text": {
          "title": "Reference Text",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "voice-contract-v1",
          "default": "voice-contract-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "voice_profile_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
          "title": "Voice Profile Id",
          "type": "string"
        }
      },
      "required": [
        "voice_profile_id",
        "revision",
        "description",
        "reference_audio_digest",
        "reference_text",
        "design_job_id",
        "candidate_id",
        "provenance",
        "created_at"
      ],
      "title": "VoiceProfile",
      "type": "object"
    },
    "VoiceRenderRequest": {
      "additionalProperties": false,
      "properties": {
        "idempotency_key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "regenerate_segment_ids": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
            "type": "string"
          },
          "title": "Regenerate Segment Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "voice-contract-v1",
          "default": "voice-contract-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "script": {
          "$ref": "#/$defs/VoiceScript"
        },
        "seed": {
          "default": 0,
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "source_job_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Job Id"
        }
      },
      "required": [
        "idempotency_key",
        "script"
      ],
      "title": "VoiceRenderRequest",
      "type": "object"
    },
    "VoiceScope": {
      "additionalProperties": false,
      "properties": {
        "body_instance_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Body Instance Id",
          "type": "string"
        },
        "profile_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
          "title": "Profile Id",
          "type": "string"
        },
        "profile_revision": {
          "minimum": 1,
          "title": "Profile Revision",
          "type": "integer"
        }
      },
      "required": [
        "body_instance_id",
        "profile_id",
        "profile_revision"
      ],
      "title": "VoiceScope",
      "type": "object"
    },
    "VoiceScript": {
      "additionalProperties": false,
      "description": "Character performance; the provider supplies the immutable voice profile.",
      "properties": {
        "segments": {
          "items": {
            "discriminator": {
              "mapping": {
                "pause": "#/$defs/PauseSegment",
                "speech": "#/$defs/SpeechSegment",
                "vocalization": "#/$defs/VocalizationSegment"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/SpeechSegment"
              },
              {
                "$ref": "#/$defs/PauseSegment"
              },
              {
                "$ref": "#/$defs/VocalizationSegment"
              }
            ]
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Segments",
          "type": "array"
        }
      },
      "required": [
        "segments"
      ],
      "title": "VoiceScript",
      "type": "object"
    },
    "VoiceStatus": {
      "additionalProperties": false,
      "properties": {
        "embodiment": {
          "$ref": "#/$defs/EmbodimentStatus"
        },
        "scope": {
          "$ref": "#/$defs/VoiceScope"
        }
      },
      "required": [
        "scope",
        "embodiment"
      ],
      "title": "VoiceStatus",
      "type": "object"
    }
  },
