          "type": "string"
        },
        "snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Sha256",
          "type": "string"
        },
        "payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Sha256",
          "type": "string"
        },
        "original_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Original Id",
          "type": "string"
        },
        "original_revision": {
          "minimum": 0,
          "title": "Original Revision",
          "type": "integer"
        },
        "semantic_status": {
          "enum": [
            "observation",
            "self_expression",
            "derived_summary",
            "historical_interpretation"
          ],
          "title": "Semantic Status",
          "type": "string"
        },
        "valid_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
