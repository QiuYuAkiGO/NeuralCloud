          "type": "string"
        },
        "observed_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Observed Fraction",
          "type": "number"
        }
      },
      "required": [
        "source_uri",
        "coverage",
        "observed_fraction"
      ],
      "title": "ContentPerception",
      "type": "object"
    },
    "DocumentPerception": {
      "additionalProperties": false,
      "properties": {
