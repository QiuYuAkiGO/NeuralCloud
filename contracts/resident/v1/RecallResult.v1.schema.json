{
  "$defs": {
    "ContentPerception": {
      "additionalProperties": false,
      "properties": {
        "source_uri": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Source Uri",
          "type": "string"
        },
        "coverage": {
          "enum": [
            "title",
            "description",
            "subtitles",
            "frames",
            "audio",
            "complete"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "observed_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Observed Fraction",
          "type": "number"
        }
      },
      "required": [
        "source_uri",
        "coverage",
        "observed_fraction"
      ],
      "title": "ContentPerception",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "original_revision": {
          "minimum": 0,
          "title": "Original Revision",
          "type": "integer"
        },
        "role": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        }
      },
      "required": [
        "record_id",
        "original_revision",
        "role"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "LegacyProvenance": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "production-memory-v1-v2",
          "default": "production-memory-v1-v2",
          "title": "Format",
          "type": "string"
        },
        "snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Sha256",
          "type": "string"
        },
        "payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Sha256",
          "type": "string"
        },
        "original_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Original Id",
          "type": "string"
        },
        "original_revision": {
          "minimum": 0,
          "title": "Original Revision",
          "type": "integer"
        },
        "semantic_status": {
          "enum": [
            "observation",
            "self_expression",
            "derived_summary",
            "historical_interpretation"
          ],
          "title": "Semantic Status",
          "type": "string"
        },
        "valid_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        },
        "topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic"
        },
        "context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context"
        },
        "source_channel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Channel"
        },
        "visibility": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Visibility",
          "type": "array"
        },
        "external_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "External Refs",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "maxItems": 128,
          "title": "Evidence",
          "type": "array"
        },
        "supersedes": {
          "items": {
            "$ref": "#/$defs/SupersessionReference"
          },
          "maxItems": 128,
          "title": "Supersedes",
          "type": "array"
        },
        "original_pinned": {
          "default": false,
          "title": "Original Pinned",
          "type": "boolean"
        },
        "original_important": {
          "default": false,
          "title": "Original Important",
          "type": "boolean"
        }
      },
      "required": [
        "snapshot_sha256",
        "payload_sha256",
        "original_id",
        "original_revision",
        "semantic_status"
      ],
      "title": "LegacyProvenance",
      "type": "object"
    },
    "RecordView": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ONLINE",
            "NOT_FOUND",
            "ARCHIVED_OFFLINE",
            "RETRACTED",
            "SOURCE_CHANGED",
            "INACTIVE"
          ],
          "title": "Status",
          "type": "string"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "occurred_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurred At"
        },
        "generation": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generation"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offset"
        },
        "total_characters": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Characters"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status",
        "record_id"
      ],
      "title": "RecordView",
      "type": "object"
    },
    "SourceInfo": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "character_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Character Id",
          "type": "string"
        },
        "source_instance": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Instance",
          "type": "string"
        },
        "event_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "session_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "conversation_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conversation Id"
        },
        "activity_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activity Id"
        },
        "occurred_at": {
          "minimum": 0,
          "title": "Occurred At",
          "type": "number"
        },
        "kind": {
          "default": "observation",
          "enum": [
            "observation",
            "self_expression",
            "summary",
            "relationship",
            "persona_history"
          ],
          "title": "Kind",
          "type": "string"
        },
        "privacy": {
          "default": "private",
          "enum": [
            "public",
            "private",
            "sensitive"
          ],
          "title": "Privacy",
          "type": "string"
        },
        "participants": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Participants",
          "type": "array"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Aliases",
          "type": "array"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Source Ids",
          "type": "array"
        },
        "pinned": {
          "default": false,
          "title": "Pinned",
          "type": "boolean"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/LegacyProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "perception": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentPerception"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "character_id",
        "source_instance",
        "event_id",
        "session_id",
        "occurred_at"
      ],
      "title": "SourceInfo",
      "type": "object"
    },
    "SupersessionReference": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "expected_revision": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        }
      },
      "required": [
        "record_id"
      ],
      "title": "SupersessionReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "status": {
      "const": "OK",
      "title": "Status",
      "type": "string"
    },
    "scope": {
      "const": "GLOBAL_ONLINE",
      "title": "Scope",
      "type": "string"
    },
    "generation": {
      "title": "Generation",
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/RecordView"
      },
      "title": "Items",
      "type": "array"
    },
    "coverage": {
      "title": "Coverage",
      "type": "string"
    }
  },
  "required": [
    "status",
    "scope",
    "generation",
    "items",
    "coverage"
  ],
  "title": "RecallResult",
  "type": "object"
}
