{
  "$defs": {
    "TextRange": {
      "additionalProperties": false,
      "description": "Half-open byte range in the extracted document, including its exact returned digest.",
      "properties": {
        "unit": {
          "const": "utf8_bytes",
          "title": "Unit",
          "type": "string"
        },
        "start": {
          "const": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "maximum": 30000,
          "title": "End",
          "type": "integer"
        },
        "total": {
          "exclusiveMinimum": 0,
          "maximum": 1048576,
          "title": "Total",
          "type": "integer"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "unit",
        "start",
        "end",
        "total",
        "truncated",
        "sha256"
      ],
      "title": "TextRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "source_uri": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Source Uri",
      "type": "string"
    },
    "coverage": {
      "const": "document_text",
      "title": "Coverage",
      "type": "string"
    },
    "observed_fraction": {
      "maximum": 1,
      "minimum": 0,
      "title": "Observed Fraction",
      "type": "number"
    },
    "text_range": {
      "$ref": "#/$defs/TextRange"
    }
  },
  "required": [
    "source_uri",
    "coverage",
    "observed_fraction",
    "text_range"
  ],
  "title": "DocumentPerception",
  "type": "object"
}
